VITE_PROJECT = "https://github.com/CareyWang/sub-web"

VITE_BOT_LINK = ""

VITE_BACKEND_RELEASE = ""

VITE_SUBCONVERTER_REMOTE_CONFIG = ""

VITE_SUBCONVERTER_DOC_ADVANCED = ""

# ===== SubHub 合并层 =====
# API 后端: 指向合并内核的 subconverter 兼容层 (/api/sub 与 /api/version)
# 同源部署 (单端口模式) 时用相对路径即可; 前后端分离时改成完整地址, 例如 http://192.168.1.10:9635/api
VITE_SUBCONVERTER_DEFAULT_BACKEND = "/api"

# 短链接后端: 使用合并内核自带的 /api/short (自托管, 不再依赖第三方)
VITE_MYURLS_API = "/api/short"

# 文本托管后端: 使用合并内核自带的 /api/upload (自托管外部配置)
VITE_CONFIG_UPLOAD_API = "/api/upload"

# 页面配置
VITE_USE_STORAGE = true
VITE_CACHE_TTL = 86400
