# ===== SubHub 环境变量示例 =====
# 用法: cp .env.example .env 后按需修改
# scripts/serve.sh 会自动读取 .env; 源码模式 (scripts/dev.sh) 直接读进程环境变量。
# ./start.sh ./stop.sh ./status.sh ./logs.sh 等一键脚本也会读取本文件。
# 全项目默认端口: 9635 (下面遇到 9635 的地方都可以按需改)

# ---------- 一键启停开关 (根目录脚本) ----------
# 监听端口 (等同于 SUB_STORE_BACKEND_API_PORT)
PORT=9635
# 置 1 则监听 0.0.0.0, 局域网设备可直接访问
LAN=0
# 打印 / 打开浏览器时使用的外部地址 (留空则按绑定地址或 hostname -I 推断)
# PUBLIC_HOST=192.168.1.10
# 启动后是否自动打开浏览器 (0 = 不打开)
OPEN_BROWSER=1
# 缺少 node_modules 时是否自动 pnpm install (0 = 直接报错)
AUTO_INSTALL=1
# 强制运行模式: dev (babel-node 源码) / bundle (dist 产物); 留空则自动选
# FORCE_MODE=bundle
# 置 1 时禁止"没有终端就自动开系统终端窗口"的行为 (cron / systemd / 远程脚本用)
# SUBHUB_NO_TERMINAL=1

# ---------- 运行环境 ----------
# node 装在非标准目录时用这个指明 bin 目录 (双击启动报 "node: 没有那个文件或目录" 时最有用)。
# 脚本本身会先找一轮: PATH -> ~/.local/nodejs/bin -> nvm/volta/asdf/fnm/mise 等 -> 登录 shell 的 PATH,
# 都找不到才会报错; 所以只有特殊情况才需要写。
# SUBHUB_NODE_DIR=/home/you/.local/nodejs/bin

# ---------- 合并层 (SubHub) ----------
# 项目根目录 (默认进程工作目录)
SUBHUB_HOME=
# 合并层配置文件路径 (默认 config/subhub.json)
SUBHUB_CONFIG=
# 默认目标平台 (不传 target 时使用)
SUBHUB_DEFAULT_TARGET=mihomo
# target=clash 是否按 Mihomo 生成 (false 则用旧版 Clash Premium 语义)
SUBHUB_CLASH_IS_MIHOMO=true

# 可选外部引擎: 设置后自动启用并出现在 /api/v1/engines
# SUBHUB_SUBCONVERTER_URL=http://127.0.0.1:25500
# SUBHUB_SUBCONVERTER_EXTENDED_URL=http://127.0.0.1:25501
# SUBHUB_SUBLINKX_URL=http://127.0.0.1:8000

# ---------- 内核 (Sub-Store) ----------
# 数据目录 (root.json / sub-store.json / 节点库)
SUB_STORE_DATA_BASE_PATH=./data
# 监听地址与端口
SUB_STORE_BACKEND_API_HOST=127.0.0.1
SUB_STORE_BACKEND_API_PORT=9635
# 内核名字 (会出现在 /api/version 和日志里)。设了它, 内核会额外放行
# http://localhost:<任意端口> 与 http://127.0.0.1:<任意端口> —— 内置界面能加载资源的前提:
# 浏览器取 /assets/*.js 时会带 Origin 头, 白名单里没有它就会 403 导致白屏。
SUB_STORE_BACKEND_CUSTOM_NAME=SubHub
# 允许跨域的额外来源: 自建前端 / 反代域名写这里。
# 留空时由 ./start.sh 自动处理本机来源; 一旦这里写了值, 脚本会把自身来源追加在其后。
# 当前生效的白名单见 ./logs.sh 里的 "[CORS] allowed origins:" 一行。
# SUB_STORE_CORS_ALLOWED_ORIGINS=https://sub.example.com
# 请求体上限
# SUB_STORE_BODY_JSON_LIMIT=1mb
# 上游订阅同步 cron (需要时打开)
# SUB_STORE_BACKEND_SYNC_CRON=0 */6 * * *
# 指定产物生成 cron: 0 */2 * * *,sub,订阅名;0 */3 * * *,col,组合名
# SUB_STORE_PRODUCE_CRON=

# ---------- 单端口模式 (后端 + 内置前端) ----------
# 前端要先构建: bash scripts/build-web.sh   (或 BUILD_WEB=1 bash scripts/build.sh)
# 一键脚本检测到 web/dist 会自动打开单端口模式; 手动模式等价于下面三个变量:
# SUB_STORE_BACKEND_MERGE=true
# SUB_STORE_FRONTEND_PATH=./web/dist
# SUB_STORE_FRONTEND_BACKEND_PATH=/
# 分离模式下的前端进程 (可选)
# SUB_STORE_FRONTEND_PORT=3001
# SUB_STORE_FRONTEND_HOST=127.0.0.1
