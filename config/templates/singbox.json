      { "tag": "ali", "address": "223.5.5.5", "detour": "DIRECT" },
      { "tag": "local", "address": "local", "detour": "DIRECT" }
    ],
    "rules": [
      { "outbound": "any", "server": "local" },
      { "clash_mode": "direct", "server": "local" }
