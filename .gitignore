# ===== SubHub =====
# 运行时数据 (sub-store.json / root.json / 节点库等)
data/
sub-store.json
sub-store_*.json
root.json
root_*.json

# 构建产物 (bundle 与前端)
dist/
sub-store.min.js
web/node_modules/
web/dist/
web/.vite/

# 依赖
node_modules/
.pnpm-store/

# 环境与本地配置
.env
.env.local
*.local

# 例外: web/.env 里只有前端构建期的相对路径 (无密钥), 上游 sub-web 也随仓库分发。
# 少了它, 克隆下来构建出的前端会回落到第三方公共服务, 不是自托管形态。
!web/.env

# 运行时状态 (PID 文件) 与桌面启动器 (含本机绝对路径, 由 scripts/desktop.sh 生成)
.run/
subhub-start.desktop
subhub-stop.desktop
subhub-open.desktop

# 日志与临时文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.seed

# 编辑器 / 系统
.DS_Store
.vscode/
.idea/
*.swp

# 工具状态
.freebuff/

# Docker
docker-data/

# ===== engines/ 是上游仓库 (各自带 .git), 不参与本仓库提交 =====
engines/
